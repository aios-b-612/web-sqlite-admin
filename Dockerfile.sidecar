# Imagem sidecar drop-in (porta 80) para platform-hosting.
#
# Build:
#   docker build -f Dockerfile.sidecar -t octor-hosting-sqlite-admin:octor-v1 .
#   docker tag octor-hosting-sqlite-admin:octor-v1 ghcr.io/0ctor/web-sqlite-admin:sidecar

FROM rust:1.88-bookworm AS api-build
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*
COPY api/Cargo.toml api/Cargo.lock ./
COPY api/src ./src
RUN cargo build --locked --release \
  && cp target/release/web-sqlite-admin-api /usr/local/bin/web-sqlite-admin-api

FROM node:22-bookworm AS fe-build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV NEXT_PUBLIC_CENTRAL_AUTH_ENABLED=false \
    NEXT_PUBLIC_SQLITE_PANEL_PASSWORD_AUTH=true \
    NEXT_PUBLIC_API_URL= \
    NEXT_TELEMETRY_DISABLED=1 \
    BUSINESS_API_INTERNAL_URL=http://127.0.0.1:8080 \
    AUTH_SECRET=sidecar-build-placeholder \
    AUTH_TRUST_HOST=true \
    NEXTAUTH_URL=http://localhost/
RUN npm run build

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --system --uid 10001 --create-home appuser
WORKDIR /app
COPY --from=api-build /usr/local/bin/web-sqlite-admin-api /usr/local/bin/web-sqlite-admin-api
COPY --from=fe-build /app/.next/standalone ./web
COPY --from=fe-build /app/.next/static ./web/.next/static
COPY --from=fe-build /app/public ./web/public
COPY scripts/sidecar-entrypoint.sh /usr/local/bin/sidecar-entrypoint.sh
RUN chmod +x /usr/local/bin/sidecar-entrypoint.sh \
  && chown -R appuser:appuser /app
USER appuser
ENV BIND_ADDRESS=0.0.0.0:8080 \
    LOCATION=/db/databases \
    OCTOR_SERVICE_NAME=web-sqlite-admin-api \
    PORT=80 \
    HOSTNAME=0.0.0.0 \
    NEXT_PUBLIC_CENTRAL_AUTH_ENABLED=false \
    NEXT_PUBLIC_SQLITE_PANEL_PASSWORD_AUTH=true \
    BUSINESS_API_INTERNAL_URL=http://127.0.0.1:8080 \
    AUTH_SECRET=change-me-in-hosting \
    AUTH_TRUST_HOST=true
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=35s --retries=3 \
  CMD curl -fsS http://127.0.0.1:80/api/health/live || curl -fsS http://127.0.0.1:8080/health/live || exit 1
ENTRYPOINT ["/usr/local/bin/sidecar-entrypoint.sh"]
