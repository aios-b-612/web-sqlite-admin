# Imagem sidecar drop-in (porta 80) para platform-hosting.
# Substitui octor-hosting-phpliteadmin: FE estático servido pela API Actix (futuro)
# ou proxy interno. MVP: só API na 8080 mapeada — staging usa compose dual.
#
# Build:
#   docker build -f Dockerfile.sidecar -t octor-hosting-sqlite-admin:dev .

FROM rust:1.88-bookworm AS api-build
WORKDIR /app
COPY api/Cargo.toml api/Cargo.lock ./
COPY api/src ./src
RUN cargo build --release

FROM node:22-bookworm AS fe-build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV NEXT_PUBLIC_CENTRAL_AUTH_ENABLED=false
ENV NEXT_PUBLIC_API_URL=
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=api-build /app/target/release/web-sqlite-admin-api /usr/local/bin/web-sqlite-admin-api
COPY --from=fe-build /app/.next/standalone /app/web
COPY --from=fe-build /app/.next/static /app/web/.next/static
COPY --from=fe-build /app/public /app/web/public
COPY scripts/sidecar-entrypoint.sh /usr/local/bin/sidecar-entrypoint.sh
RUN chmod +x /usr/local/bin/sidecar-entrypoint.sh
ENV BIND_ADDRESS=0.0.0.0:8080 \
    LOCATION=/db/databases \
    OCTOR_SERVICE_NAME=web-sqlite-admin-api \
    PORT=80 \
    HOSTNAME=0.0.0.0 \
    NEXT_PUBLIC_CENTRAL_AUTH_ENABLED=false \
    NEXT_PUBLIC_SQLITE_PANEL_PASSWORD_AUTH=true \
    BUSINESS_API_INTERNAL_URL=http://127.0.0.1:8080
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -fsS http://127.0.0.1:80/api/health/live || curl -fsS http://127.0.0.1:8080/health/live || exit 1
ENTRYPOINT ["/usr/local/bin/sidecar-entrypoint.sh"]
