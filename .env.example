# Authentication Secret (NextAuth local / scaffold). Gere: openssl rand -base64 32
# Em produção com SSO web-auth, o login local NÃO é o caminho de produto.
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000/
AUTH_TRUST_HOST=true

# --- Octor SSO (obrigatório em produção / build de app de cliente) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_API_URL=https://auth.octor.com.br/v1
NEXT_PUBLIC_AUTH_PORTAL_URL=https://auth.octor.com.br
# Id no AppMenu registry (ex. stock, crm). Obrigatório em app de produto.
NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_APP_MENU_ENV=development
# false = scaffold local com NextAuth (Google/GitHub/credentials)
NEXT_PUBLIC_CENTRAL_AUTH_ENABLED=true

# Nome do serviço nos health checks JSON
OCTOR_SERVICE_NAME=template-frontend

# BFF /api/errors/report → API de negócio (Loki). Vazio = 204 no scaffold.
BUSINESS_API_INTERNAL_URL=

# OAuth local (só se CENTRAL_AUTH_ENABLED=false)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=
