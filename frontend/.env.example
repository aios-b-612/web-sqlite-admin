# Authentication Secret (NextAuth local / scaffold). Gere: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me
NEXTAUTH_URL=http://localhost:3000/
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
# API Rust do admin (mesmo host via Traefik em produção)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_AUTH_API_URL=https://auth.octor.com.br/v1
NEXT_PUBLIC_AUTH_PORTAL_URL=https://auth.octor.com.br
NEXT_PUBLIC_APP_ID=sqlite-admin
NEXT_PUBLIC_APP_MENU_ENV=development
# Sidecar hosting: painel por senha (PASSWORD na API) — SSO off
NEXT_PUBLIC_CENTRAL_AUTH_ENABLED=false
# true (default) = login por senha da API; false = SSO/NextAuth do template
NEXT_PUBLIC_SQLITE_PANEL_PASSWORD_AUTH=true

OCTOR_SERVICE_NAME=web-sqlite-admin
BUSINESS_API_INTERNAL_URL=http://127.0.0.1:8080

GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=
