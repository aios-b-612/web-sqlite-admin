APP_ENV=development
OCTOR_SERVICE_NAME=web-sqlite-admin-api
BIND_ADDRESS=0.0.0.0:8080

# Compatível com platform-hosting / phpLiteAdmin
PASSWORD=change-me
LOCATION=/tmp/octor-sqlite-admin
# SESSION_SECRET=opcional-override

# Opcional: aceitar também Bearer do web-auth
# AUTH_INTROSPECT_URL=https://auth.octor.com.br/v1/auth/introspect
AUTH_TIMEOUT_MS=2000
ALLOWED_CORS_ORIGINS=http://localhost:3000

# Loki (opcional em local)
LOKI_PUSH_URL=
LOKI_PUSH_USER=
LOKI_PUSH_PASSWORD=
LOKI_JOB=web-sqlite-admin-api

RUST_LOG=web_sqlite_admin_api=info,actix_web=info
